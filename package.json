{
  "name": "gearspot-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web",
    "preview:web": "python3 -m http.server 4173 --directory dist",
    "preview:web:stable": "node server/web-preview.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "server": "node server/index.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "test": "jest",
    "test:unit": "jest",
    "test:e2e": "npx playwright test",
    "smoke:deploy": "node scripts/smoke_deploy.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "release:gate": "bash scripts/release_gate.sh",
    "release:easy": "bash scripts/release_easy.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@expo/metro-runtime": "^57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.12",
    "@sendgrid/mail": "^8.1.6",
    "@stripe/stripe-react-native": "^0.71.0",
    "@upstash/redis": "^1.35.3",
    "@vercel/kv": "^3.0.0",
    "@vercel/postgres": "^0.10.0",
    "cors": "^2.8.5",
    "expo": "^54.0.36",
    "expo-status-bar": "~3.0.9",
    "express": "^4.18.2",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "1.40.0",
    "@testing-library/jest-native": "5.4.1",
    "@testing-library/react-native": "13.3.1",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-jest": "29.6.1",
    "babel-preset-expo": "~54.0.10",
    "eslint": "8.47.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "~29.7.0",
    "prettier": "3.9.5",
    "react-test-renderer": "^19.1.0"
  }
}
